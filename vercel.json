{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/**/requirements.txt",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    },
    {
      "src": "/api/send-link",
      "dest": "/api/send_link.py"
    },
    {
      "src": "/api/verify-link",
      "dest": "/api/verify_link.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
