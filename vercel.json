{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/send-link",
      "dest": "/api/send-link.js"
    },
    {
      "src": "/api/verify-link",
      "dest": "/api/verify-link.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
